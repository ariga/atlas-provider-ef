    [BlogId] int NOT NULL IDENTITY,
    [Url] varchar(200) NOT NULL,
    [Rating] decimal(5,2) NOT NULL,
    [Title] nvarchar(max) NOT NULL,
    [Content] nvarchar(max) NOT NULL,
